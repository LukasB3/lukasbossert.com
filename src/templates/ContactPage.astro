---
import Base from '../layouts/Base.astro';
import LinkList from '../components/LinkList.astro';
import { site, ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const items = [
  { title: t.contact.email, detail: site.email, href: `mailto:${site.email}` },
  { title: 'GitHub', detail: site.github.replace('https://', ''), href: site.github, external: true },
  { title: 'LinkedIn', detail: 'linkedin.com/in/lukas-bossert', href: site.linkedin, external: true },
  // CV: add public/cv-lukas-bossert.pdf and uncomment.
  // { title: 'CV', detail: 'PDF', href: '/cv-lukas-bossert.pdf' },
];
---

<Base lang={lang} page="contact">
  <div class="page">
    <h1 class="page-title">{t.contact.title}</h1>
    <div class="page-body">
      <LinkList items={items} label={t.nav.contact} />
    </div>
  </div>
</Base>
