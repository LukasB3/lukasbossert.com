---
import Base from '../layouts/Base.astro';
import { ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<Base lang={lang} page="notes">
  <article class="page">
    <h1 class="page-title">{t.notes.title}</h1>
    <div class="page-body">
      <p>{t.notes.soon}</p>
    </div>
  </article>
</Base>
