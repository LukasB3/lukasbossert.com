---
import Base from '../layouts/Base.astro';
import Pipeline from '../components/Pipeline.astro';
import { routes, ui, type Lang, type NavKey } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const keys: NavKey[] = ['about', 'projects', 'thinking', 'contact'];
---

<Base lang={lang} page="home">
  <Fragment slot="backdrop">
    <Pipeline label={t.canvasLabel} />
    <nav class="station-nav" aria-label={t.navLabel} data-station-nav>
      {keys.map((k) => (
        <a href={routes[k][lang]} data-station>
          <span class="name">{t.nav[k]}</span>
          <span class="info">{t.navInfo[k]}</span>
        </a>
      ))}
    </nav>
  </Fragment>
  <div class="poster">
    <h1>{t.tagline}</h1>
  </div>
  <p slot="footer" class="where">{t.where}</p>
</Base>

<style>
  .station-nav {
    position: fixed;
    top: 5rem;
    right: var(--gutter);
    z-index: 2;
    display: grid;
    justify-items: end;
    gap: 0.5rem;
  }

  .station-nav.placed {
    display: contents;
  }

  .station-nav a {
    display: block;
    text-decoration: none;
    color: var(--ink);
    white-space: nowrap;
  }

  .station-nav.placed a {
    position: fixed;
    z-index: 2;
    transform: translate(-50%, -50%);
  }

  .station-nav.placed a:hover,
  .station-nav.placed a:focus-visible {
    z-index: 3;
  }

  .name {
    display: block;
    padding: 0.45em 0.85em;
    border: 1.5px solid var(--ink);
    background: var(--bg);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1;
    transition: transform 160ms, background-color 120ms, color 120ms, border-color 120ms;
  }

  .info {
    display: none;
    position: absolute;
    top: calc(100% + 0.6rem);
    left: 50%;
    transform: translateX(-50%);
    width: 24ch;
    padding: 0.5em 0.8em;
    background: var(--bg);
    text-align: center;
    white-space: normal;
    font-size: 0.95rem;
    line-height: 1.3;
    color: var(--ink);
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms 60ms;
  }

  .station-nav.placed .info {
    display: block;
  }

  .station-nav a:hover .name,
  .station-nav a:focus-visible .name {
    transform: scale(1.12);
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }

  .station-nav a:hover .info,
  .station-nav a:focus-visible .info {
    opacity: 1;
    pointer-events: auto;
  }

  .poster {
    padding: 1.5rem var(--gutter) 0;
  }

  h1 {
    font-size: var(--poster);
    line-height: 1.02;
    max-width: 24ch;
    text-wrap: balance;
  }

  .where {
    margin: 0;
    max-width: 30ch;
    line-height: 1.4;
  }

  @media (prefers-reduced-motion: reduce) {
    .name,
    .info {
      transition: none;
    }
  }
</style>
