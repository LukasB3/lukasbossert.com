---
import Base from '../layouts/Base.astro';
import Minimap from '../components/Minimap.astro';
import { routes, ui, type Lang, type PageKey } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const keys: Exclude<PageKey, 'home'>[] = ['about', 'projects', 'thinking', 'contact'];
---

<Base lang={lang} page="home" nav={false}>
  <Fragment slot="backdrop">
    <Minimap label={t.canvasLabel} />
    <nav class="code-nav" aria-label={t.navLabel} data-code-nav>
      {keys.map((k) => (
        <a href={routes[k][lang]} data-code-link>
          <span class="name">{t.nav[k]}</span>
          <span class="info">{t.navInfo[k]}</span>
        </a>
      ))}
    </nav>
  </Fragment>
  <div class="poster">
    <h1>{t.tagline}</h1>
  </div>
  <p slot="footer" class="where">{t.where}</p>
</Base>

<style>
  .code-nav {
    position: fixed;
    top: 5rem;
    right: var(--gutter);
    z-index: 2;
    display: grid;
    justify-items: end;
    gap: 0.5rem;
  }

  .code-nav.placed {
    display: contents;
  }

  .code-nav a {
    display: block;
    padding: 0.25rem 0.5rem 0.25rem 0;
    margin-top: -0.25rem;
    text-decoration: none;
    color: var(--ink);
    line-height: 1;
    white-space: nowrap;
  }

  .code-nav.placed a {
    position: fixed;
    z-index: 2;
  }

  .name {
    display: block;
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1;
    transition: font-size 180ms, color 120ms;
  }

  .info {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    width: 22ch;
    white-space: normal;
    line-height: 1.3;
    color: var(--ink-2);
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms 60ms;
  }

  .code-nav.placed .info {
    display: block;
  }

  .code-nav a:hover .info {
    pointer-events: auto;
  }

  .code-nav a:hover .name,
  .code-nav a:focus-visible .name {
    font-size: 2.25rem;
    color: var(--accent);
  }

  .code-nav a:hover .info,
  .code-nav a:focus-visible .info {
    opacity: 1;
  }

  .poster {
    min-height: 100%;
    display: grid;
    align-content: end;
    padding: 4rem var(--gutter) 2rem;
  }

  h1 {
    font-size: var(--poster);
    line-height: 1;
    max-width: 26ch;
    text-wrap: balance;
  }

  .where {
    margin: 0;
    max-width: 30ch;
    line-height: 1.4;
  }

  @media (min-width: 720px) {
    .where {
      text-align: right;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .name,
    .info {
      transition: none;
    }
  }
</style>
