---
import Base from '../layouts/Base.astro';
import Pipeline from '../components/Pipeline.astro';
import { routes, ui, type Lang, type NavKey } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const keys: NavKey[] = ['about', 'projects', 'notes', 'contact'];
---

<Base lang={lang} page="home">
  <Fragment slot="backdrop">
    <Pipeline label={t.canvasLabel} />
    <nav class="station-nav" aria-label={t.navLabel} data-station-nav>
      {keys.map((k) => (
        <a href={routes[k][lang]} data-station>
          <span class="name">{t.nav[k]}</span>
          <span class="info"><span>{t.navInfo[k]}</span></span>
        </a>
      ))}
    </nav>
  </Fragment>
  <div class="poster">
    <h1>{t.tagline}</h1>
  </div>
  <p slot="footer" class="where">{t.where}</p>
</Base>

<style>
  .station-nav {
    position: fixed;
    top: 5rem;
    right: var(--gutter);
    z-index: 2;
    display: grid;
    justify-items: end;
    gap: 0.5rem;
  }

  .station-nav.placed {
    display: contents;
  }

  /* The link is the station box; on hover it fills and opens around its centre to show the one-liner. */
  .station-nav a {
    display: grid;
    justify-items: center;
    padding: 0.45em 0.85em;
    border: 1.5px solid var(--ink);
    background: var(--bg);
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
    interpolate-size: allow-keywords;
    transition: background-color 120ms, color 120ms, border-color 120ms;
  }

  .station-nav.placed a {
    position: fixed;
    z-index: 2;
    transform: translate(-50%, -50%);
  }

  .station-nav.placed a:hover,
  .station-nav.placed a:focus-visible {
    z-index: 3;
  }

  .name {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1;
  }

  .info {
    display: none;
    grid-template-rows: 0fr;
    width: 0;
    overflow: hidden;
    opacity: 0;
    font-size: 0.9rem;
    line-height: 1.3;
    transition: grid-template-rows 200ms, width 200ms, opacity 160ms;
  }

  .info span {
    min-height: 0;
    padding-top: 0.4em;
  }

  .station-nav.placed .info {
    display: grid;
  }

  .station-nav a:hover,
  .station-nav a:focus-visible {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }

  .station-nav a:hover .info,
  .station-nav a:focus-visible .info {
    grid-template-rows: 1fr;
    width: auto;
    opacity: 1;
  }

  .poster {
    padding: 1.5rem var(--gutter) 0;
  }

  h1 {
    font-size: var(--poster);
    line-height: 1.02;
    max-width: 24ch;
    text-wrap: balance;
  }

  .where {
    margin: 0;
    max-width: 30ch;
    line-height: 1.4;
  }

  @media (prefers-reduced-motion: reduce) {
    .station-nav a,
    .info {
      transition: none;
    }
  }
</style>
