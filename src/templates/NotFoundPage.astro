---
import Base from '../layouts/Base.astro';
import { routes, ui } from '../i18n';

const t = ui.en;
---

<Base lang="en" page="404">
  <div class="page">
    <h1 class="page-title">{t.notFound.title}</h1>
    <div class="page-body">
      <p><a href={routes.home.en}>{t.notFound.back}</a></p>
      <p lang="de"><a href={routes.home.de}>{ui.de.notFound.back}</a></p>
    </div>
  </div>
</Base>
