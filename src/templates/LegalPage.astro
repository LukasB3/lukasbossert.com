---
import Base from '../layouts/Base.astro';
import { site, ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<Base lang={lang} page="legal">
  <article class="page">
    <h1 class="page-title">{t.legal.title}</h1>
    <div class="page-body">
      <p>{t.legal.intro}</p>
      <p class="address">
        {site.name}<br />
        {site.street}<br />
        {site.postal}
      </p>
      <h2>{t.legal.contact}</h2>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <h2>{t.legal.responsible}</h2>
      <p class="address">
        {site.name}<br />
        {site.street}<br />
        {site.postal}
      </p>
      {t.legal.sections.map((s) => (
        <>
          <h2>{s.h}</h2>
          <p>{s.p}</p>
        </>
      ))}
      <h2 class="privacy" id="privacy">{t.privacy.title}</h2>
      <p>{t.privacy.intro}</p>
      {t.privacy.sections.map((s) => (
        <>
          <h3>{s.h}</h3>
          <p>{s.p}</p>
        </>
      ))}
    </div>
  </article>
</Base>

<style>
  h2 {
    margin-top: 2.25rem;
    font-size: 1.25rem;
    line-height: 1.2;
  }

  .privacy {
    margin-top: 4rem;
    font-size: 1.75rem;
    scroll-margin-top: 2rem;
  }

  h3 {
    margin: 2rem 0 0;
    font-size: 1.1rem;
    line-height: 1.2;
    font-weight: 700;
    font-variation-settings: 'wdth' 112;
    letter-spacing: -0.02em;
  }

  .address {
    line-height: 1.5;
  }
</style>
