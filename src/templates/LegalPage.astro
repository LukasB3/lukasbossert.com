---
import Base from '../layouts/Base.astro';
import { ui, type Lang } from '../i18n';
import { legal, type Block, type Paragraph } from '../data/legal';

interface Props {
  lang: Lang;
  page: 'legal' | 'privacy';
}

const { lang, page } = Astro.props;
const t = ui[lang];
const doc = legal[lang][page];

const isList = (block: Block): block is { list: Paragraph[] } => typeof block === 'object' && !Array.isArray(block);
const parts = (paragraph: Paragraph) => (typeof paragraph === 'string' ? [paragraph] : paragraph);
---

<Base lang={lang} page={page}>
  <article class="page">
    <h1 class="page-title">{t.titles[page]}</h1>
    <div class="page-body">
      {doc.sections.map((section) => (
        <>
          <h2 id={section.id}>{section.heading}</h2>
          {section.body.map((block) =>
            isList(block) ? (
              <ul>{block.list.map((item) => <li>{parts(item).map((part) => (typeof part === 'string' ? part : <a href={part.href}>{part.text}</a>))}</li>)}</ul>
            ) : (
              <p>{parts(block).map((part) => (typeof part === 'string' ? part : <a href={part.href}>{part.text}</a>))}</p>
            ),
          )}
        </>
      ))}
      <p class="updated">{doc.updated}</p>
    </div>
  </article>
</Base>

<style>
  h2 {
    margin-top: 2.25rem;
    font-size: 1.25rem;
    line-height: 1.2;
    /* A section opened through its address (/privacy#chat) starts a little below the top. */
    scroll-margin-top: 2rem;
  }

  h2:first-child {
    margin-top: 0;
  }

  /* An address keeps its lines. */
  p {
    white-space: pre-line;
  }

  ul {
    margin: 0 0 1em;
    padding-left: 1.2em;
  }

  li {
    margin-bottom: 0.4em;
  }

  .updated {
    margin: 2.5rem 0 0;
    font-size: 0.9rem;
    color: var(--ink-2);
  }
</style>
