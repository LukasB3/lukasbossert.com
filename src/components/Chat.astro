---
import { routes, ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].chat;
const privacyHref = `${routes.legal[lang]}#privacy`;
---

<div
  class="chat"
  data-chat
  data-lang={lang}
  data-error={t.error}
  data-limit={t.limit}
  data-you={t.you}
  data-assistant={t.assistant}
>
  <button class="chat-toggle" type="button" data-chat-toggle aria-expanded="false" aria-controls="chat-panel">
    {t.open}
  </button>
  <section class="chat-panel" id="chat-panel" role="dialog" aria-labelledby="chat-title" data-chat-panel hidden>
    <div class="chat-head">
      <h2 class="chat-title" id="chat-title">{t.title}</h2>
      <button class="chat-close" type="button" data-chat-close aria-label={t.close}>{t.closeShort}</button>
    </div>
    <div class="chat-log" data-chat-log aria-live="polite">
      <p class="msg intro">{t.intro}</p>
    </div>
    <form class="chat-form">
      <textarea name="message" rows="2" maxlength="1000" placeholder={t.placeholder} aria-label={t.placeholder} required></textarea>
      <button type="submit">{t.send}</button>
    </form>
    <p class="chat-note">
      {t.note}
      <a href={privacyHref}>{t.privacy}</a>
    </p>
  </section>
</div>

<script>
  import { mount } from '../scripts/chat';
  document.querySelectorAll<HTMLElement>('[data-chat]').forEach(mount);
</script>

<style>
  .chat {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
  }

  .chat-toggle,
  .chat-form button {
    font: inherit;
    font-weight: 600;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--ink);
    padding: 0.55rem 1rem;
    cursor: pointer;
    transition: background 120ms, color 120ms, border-color 120ms;
  }

  .chat-toggle:hover,
  .chat-toggle:focus-visible,
  .chat-form button:hover,
  .chat-form button:focus-visible,
  .is-open .chat-toggle {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }

  .chat-form button:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .chat-panel {
    display: flex;
    flex-direction: column;
    width: min(24rem, calc(100vw - 2.5rem));
    height: min(32rem, calc(100dvh - 6rem));
    background: var(--bg);
    border: 1px solid var(--ink);
  }

  .chat-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1rem 0.6rem;
    border-bottom: 1px solid var(--line);
  }

  .chat-title {
    font-size: 1.05rem;
    line-height: 1.2;
  }

  .chat-close {
    font: inherit;
    font-size: 0.9rem;
    color: var(--ink-2);
    background: none;
    border: 0;
    padding: 0.2rem 0;
    cursor: pointer;
  }

  .chat-close:hover,
  .chat-close:focus-visible {
    color: var(--accent);
  }

  .chat-log {
    flex: 1;
    overflow-y: auto;
    padding: 0.85rem 1rem 0.25rem;
    font-size: 0.95rem;
    line-height: 1.45;
    overscroll-behavior: contain;
  }

  .chat-log :global(.msg) {
    display: flex;
    flex-direction: column;
    max-width: 88%;
    margin: 0 0 0.9rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .chat-log :global(.user) {
    margin-left: auto;
    text-align: right;
  }

  .chat-log :global(.intro) {
    color: var(--ink-2);
  }

  .chat-log :global(.who) {
    font-size: 0.75rem;
    color: var(--ink-2);
  }

  .chat-log :global(.pending)::after {
    content: '…';
    color: var(--ink-2);
  }

  .chat-form {
    display: flex;
    align-items: stretch;
    border-top: 1px solid var(--line);
  }

  .chat-form textarea {
    flex: 1;
    min-width: 0;
    font: inherit;
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--ink);
    background: transparent;
    border: 0;
    padding: 0.7rem 1rem;
    resize: none;
  }

  .chat-form textarea:focus-visible {
    outline-offset: -2px;
  }

  .chat-form button {
    border-width: 0 0 0 1px;
    border-color: var(--line);
  }

  .chat-note {
    margin: 0;
    padding: 0.5rem 1rem 0.65rem;
    border-top: 1px solid var(--line);
    font-size: 0.75rem;
    line-height: 1.35;
    color: var(--ink-2);
  }

  @media (max-width: 720px) {
    .chat {
      right: 1rem;
      bottom: 1rem;
    }
    .chat-panel {
      width: calc(100vw - 2rem);
      height: min(34rem, calc(100dvh - 5.5rem));
    }
  }
</style>
