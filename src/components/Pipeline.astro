---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<canvas class="pipeline" role="img" aria-label={label} data-pipeline></canvas>

<script>
  import { mount } from '../scripts/pipeline';
  document.querySelectorAll<HTMLCanvasElement>('[data-pipeline]').forEach(mount);
</script>

<style>
  .pipeline {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
</style>
